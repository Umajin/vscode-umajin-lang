{
	"comments": {
		"lineComment": "//",
		"blockComment": [ "/*", "*/" ]
	},
	// symbols used as brackets
	"brackets": [
		["{", "}"],
		["[", "]"],
		["(", ")"],
		// Everything is turned off due to the problem with `property`. LS should take it over.
		// ["define", "end"],
		// ["instance", "end"],
		// ["method", "end"],
		// skipping `property` on purpose because it is not necessarily paired with `end`
		// ["scope", "end"],
		// ["if", "end"],
		// ["switch", "end"],
		// ["loop", "end"]
	],
	// symbols that are auto closed when typing
	"autoClosingPairs": [
		["{", "}"],
		["[", "]"],
		["(", ")"],
		{"open": "\"", "close": "\"", "notIn": ["string", "comment"]},
		{"open": "'", "close": "'", "notIn": ["string", "comment"]},
		{"open": "`", "close": "`", "notIn": ["string", "comment"]}
	],
	// symbols that that can be used to surround a selection
	"surroundingPairs": [
		["{", "}"],
		["[", "]"],
		["(", ")"],
		["\"", "\""],
		["'", "'"],
		["`", "`"]
	],
	"folding": {
		"markers": {
			"start": "^\\s*(?:(?:(?:define|if|instance|loop|scope|switch)\\b)|(?:method\\s+\\w+)|(?:property\\b[^=]*$))",
			"end": "^\\s*end\\b"
		}
	},
	"indentationRules": {
		"increaseIndentPattern": "^\\s*(?:(?:(?:define|if|instance|loop|scope|switch|case|elseif|else)\\b)|(?:method\\s+\\w+)|(?:property\\b[^=]*$))",
		"decreaseIndentPattern": "^\\s*(?:end|case|elseif|else)\\b"
	}
}