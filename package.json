{
	"name": "umajin-lang",
	"displayName": "Umajin Language",
	"description": "Provides Umajin language support for Visual Studio Code.",
	"version": "1.10.1",
	"license": "MIT",
	"publisher": "umajin-kuzmashapran",
	"private": false,
	"author": {
		"name": "Umajin",
		"url": "https://umajin.com"
	},
	"contributors": [
		{
			"name": "Adam Harte",
			"email": "adam@adamharte.com",
			"url": "http://adamharte.com"
		},
		{
			"name": "James Fleming",
			"email": "jaemz@alum.mit.edu"
		},
		{
			"name": "Kuzma Shapran",
			"email": "kuzma.shapran@umajin.com"
		}
	],
	"categories": [
		"Programming Languages",
		"Debuggers"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Umajin/vscode-umajin-lang.git"
	},
	"bug": {
		"url": "https://github.com/Umajin/vscode-umajin-lang/issues"
	},
	"homepage": "https://github.com/Umajin/vscode-umajin-lang",
	"icon": "images/umajin-logo.png",
	"galleryBanner": {
		"color": "#23323d",
		"theme": "dark"
	},
	"keywords": [
		"multi-root ready"
	],
	"activationEvents": [
		"workspaceContains:**/umajin"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"title": "Generate Umajin Standard Library",
				"command": "umajin.generateStdLib"
			},
			{
				"title": "Generate Umajin VS Code Workspace File",
				"command": "umajin.generateWorkspace"
			},
			{
				"title": "Apply all code actions in Umajin project",
				"command": "umajin.applyAllCodeActions"
			},
			{
				"title": "Autoformat all Umajin files",
				"command": "umajin.autoformatAll"
			},
			{
				"title": "Stop Umajin Language Client",
				"command": "umajin.stopLanguageClient"
			},
			{
				"title": "Start Umajin Language Client",
				"command": "umajin.startLanguageClient"
			},
			{
				"title": "Restart Umajin Language Client",
				"command": "umajin.restartLanguageClient"
			},
			{
				"title": "Report the status of Umajin Language Client",
				"command": "umajin.statusLanguageClient"
			},
			{
				"title": "Open Umajin engine documentation (help)",
				"command": "umajin.openEngineHelp"
			},
			{
				"title": "Install or update Umajin support",
				"command": "umajin.updateEngine"
			},
			{
				"title": "Run",
				"command": "umajin.run",
				"icon": "$(play)"
			}
		],
		"breakpoints": [
			{
				"language": "umajin"
			}
		],
		"configuration": {
			"title": "Umajin",
			"properties": {
				"umajin.advanced.languageServer.command": {
					"type": "string",
					"default": "",
					"markdownDescription": "Command to use instead of the Umajin Language Server specified by `#umajin.path.languageServer#`.",
					"scope": "window"
				},
				"umajin.advanced.languageServer.arguments": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "Arguments for Umajin Language Server",
					"scope": "window"
				},
				"umajin.collapseLongMessages": {
					"type": "boolean",
					"default": true,
					"description": "Collapse multiline compilation messages",
					"scope": "window"
				},
				"umajin.engineHelp.local.ignoreVersion": {
					"type": "boolean",
					"default": false,
					"description": "Ignore version mismatch between the Umajin Language Server and the local Umajin Engine documentation",
					"scope": "window"
				},
				"umajin.engineHelp.local.path": {
					"type": "string",
					"default": "engine_help",
					"description": "Path to local Umajin Engine documentation",
					"scope": "window"
				},
				"umajin.engineHelp.remote.server": {
					"type": "string",
					"default": "engine-help.ur.local",
					"description": "Server name for the Umajin Engine documentation links",
					"scope": "window"
				},
				"umajin.engineHelp.remote.secure": {
					"type": "boolean",
					"default": false,
					"description": "Use secure HTTP protocol for the Umajin Engine documentation links",
					"scope": "window"
				},
				"umajin.outputHighlighting": {
					"type": "array",
					"items": {
						"type": "object",
						"title": "Highlighting rule",
						"properties": {
							"match": {
								"type": "string",
								"default": "",
								"description": "The substring to search or the regular expression to match"
							},
							"asRegex": {
								"type": "boolean",
								"default": false,
								"description": "Treat the 'match' string as a regular expression"
							},
							"caseSensitive": {
								"type": "boolean",
								"default": true,
								"description": "Perform case sensitive search / match"
							},
							"invert": {
								"type": "boolean",
								"default": false,
								"description": "Invert the search / match result"
							},
							"applyTo": {
								"type": "string",
								"enum": [
									"sourceInfo",
									"logProducer",
									"logLevel",
									"message"
								],
								"default": "message",
								"description": "Portion of the log entry to apply the search / regex to",
								"enumDescriptions": [
									"Source info",
									"Log producer",
									"Log level",
									"Message"
								]
							},
							"action": {
								"type": "string",
								"enum": [
									"highlight",
									"remove"
								],
								"default": "highlight",
								"description": "The action to do if the string is found / matched",
								"enumDescriptions": [
									"Apply highlighting",
									"Remove"
								]
							},
							"foreground": {
								"type": "string",
								"default": "",
								"description": "Foreground color to mix in",
								"format": "color"
							},
							"background": {
								"type": "string",
								"default": "",
								"description": "Background color to mix in",
								"format": "color"
							},
							"bold": {
								"type": "string",
								"enum": [
									"keep",
									"on",
									"off"
								],
								"default": "keep",
								"description": "Bold (last matched rule wins)",
								"enumDescriptions": [
									"Do not modify",
									"Turn on",
									"Turn off"
								]
							},
							"italic": {
								"type": "string",
								"enum": [
									"keep",
									"on",
									"off"
								],
								"default": "keep",
								"description": "Italic (last matched rule wins)",
								"enumDescriptions": [
									"Do not modify",
									"Turn on",
									"Turn off"
								]
							}
						}
					},
					"default": [],
					"description": "Output highlighting rules",
					"scope": "window"
				},
				"umajin.path.compiler": {
					"type": "string",
					"default": ".",
					"description": "The default path to Umajin Compiler executable (relative to a workspace)",
					"scope": "window"
				},
				"umajin.path.linux.compiler": {
					"type": "string",
					"default": "",
					"markdownDescription": "The path to Umajin Compiler executable on any Linux (relative to a workspace). Falls back to `#umajin.path.compiler#`",
					"scope": "window"
				},
				"umajin.path.linux.aarch64.compiler": {
					"type": "string",
					"default": "",
					"markdownDescription": "The path to Umajin Compiler executable on AArch64 Linux (relative to a workspace). Falls back to `#umajin.path.linux.compiler#`",
					"scope": "window"
				},
				"umajin.path.linux.x86_64.compiler": {
					"type": "string",
					"default": "",
					"markdownDescription": "The path to Umajin Compiler executable on x86_64 Linux (relative to a workspace). Falls back to `#umajin.path.linux.compiler#`",
					"scope": "window"
				},
				"umajin.path.osx.compiler": {
					"type": "string",
					"default": "",
					"markdownDeprecationMessage": "Use `#umajin.path.mac.compiler#` instead",
					"scope": "window"
				},
				"umajin.path.mac.compiler": {
					"type": "string",
					"default": "",
					"markdownDescription": "The path to Umajin Compiler executable on Mac (relative to a workspace). Falls back to `#umajin.path.compiler#`",
					"scope": "window"
				},
				"umajin.path.windows.compiler": {
					"type": "string",
					"default": "",
					"markdownDescription": "The path to Umajin Compiler executable on Windows (relative to a workspace). Falls back to `#umajin.path.compiler#`",
					"scope": "window"
				},
				"umajin.path.cliEngine": {
					"type": "string",
					"default": ".",
					"description": "The default path to Umajin JIT CLI engine executable (relative to a workspace)",
					"scope": "window"
				},
				"umajin.path.linux.cliEngine": {
					"type": "string",
					"default": "",
					"markdownDescription": "The path to Umajin JIT CLI engine executable on any Linux (relative to a workspace). Falls back to `#umajin.path.cliEngine#`",
					"scope": "window"
				},
				"umajin.path.linux.aarch64.cliEngine": {
					"type": "string",
					"default": "",
					"markdownDescription": "The path to Umajin JIT CLI engine executable on AArch64 Linux (relative to a workspace). Falls back to `#umajin.path.linux.cliEngine#`",
					"scope": "window"
				},
				"umajin.path.linux.x86_64.cliEngine": {
					"type": "string",
					"default": "",
					"markdownDescription": "The path to Umajin JIT CLI engine executable on x86_64 Linux (relative to a workspace). Falls back to `#umajin.path.linux.cliEngine#`",
					"scope": "window"
				},
				"umajin.path.osx.cliEngine": {
					"type": "string",
					"default": "",
					"markdownDeprecationMessage": "Use `#umajin.path.mac.cliEngine#` instead",
					"scope": "window"
				},
				"umajin.path.mac.cliEngine": {
					"type": "string",
					"default": "",
					"markdownDescription": "The path to Umajin JIT CLI engine executable on Mac (relative to a workspace). Falls back to `#umajin.path.cliEngine#`",
					"scope": "window"
				},
				"umajin.path.windows.cliEngine": {
					"type": "string",
					"default": "",
					"markdownDescription": "The path to Umajin JIT CLI engine executable on Windows (relative to a workspace). Falls back to `#umajin.path.cliEngine#`",
					"scope": "window"
				},
				"umajin.path.jitEngine": {
					"type": "string",
					"default": ".",
					"description": "The default path to Umajin JIT GUI engine executable (relative to a workspace)",
					"scope": "window"
				},
				"umajin.path.linux.jitEngine": {
					"type": "string",
					"default": "",
					"markdownDescription": "The path to Umajin JIT GUI engine executable on any Linux (relative to a workspace). Falls back to `#umajin.path.jitEngine#`",
					"scope": "window"
				},
				"umajin.path.linux.aarch64.jitEngine": {
					"type": "string",
					"default": "",
					"markdownDescription": "The path to Umajin JIT GUI engine executable on AArch64 Linux (relative to a workspace). Falls back to `#umajin.path.linux.jitEngine#`",
					"scope": "window"
				},
				"umajin.path.linux.x86_64.jitEngine": {
					"type": "string",
					"default": "",
					"markdownDescription": "The path to Umajin JIT GUI engine executable on x86_64 Linux (relative to a workspace). Falls back to `#umajin.path.linux.jitEngine#`",
					"scope": "window"
				},
				"umajin.path.osx.jitEngine": {
					"type": "string",
					"default": "",
					"markdownDeprecationMessage": "Use `#umajin.path.mac.jitEngine#` instead",
					"scope": "window"
				},
				"umajin.path.mac.jitEngine": {
					"type": "string",
					"default": "",
					"markdownDescription": "The path to Umajin JIT GUI engine executable on Mac (relative to a workspace). Falls back to `#umajin.path.jitEngine#`",
					"scope": "window"
				},
				"umajin.path.windows.jitEngine": {
					"type": "string",
					"default": "",
					"markdownDescription": "The path to Umajin JIT GUI engine executable on Windows (relative to a workspace). Falls back to `#umajin.path.jitEngine#`",
					"scope": "window"
				},
				"umajin.path.languageServer": {
					"type": "string",
					"default": ".",
					"description": "The default path to Umajin Language Server executable (relative to a workspace)",
					"scope": "window"
				},
				"umajin.path.linux.languageServer": {
					"type": "string",
					"default": "",
					"markdownDescription": "The path to Umajin Language Server executable on any Linux (relative to a workspace). Falls back to `#umajin.path.languageServer#`",
					"scope": "window"
				},
				"umajin.path.linux.aarch64.languageServer": {
					"type": "string",
					"default": "",
					"markdownDescription": "The path to Umajin Language Server executable on AArch64 Linux (relative to a workspace). Falls back to `#umajin.path.linux.languageServer#`",
					"scope": "window"
				},
				"umajin.path.linux.x86_64.languageServer": {
					"type": "string",
					"default": "",
					"markdownDescription": "The path to Umajin Language Server executable on x86_64 Linux (relative to a workspace). Falls back to `#umajin.path.linux.languageServer#`",
					"scope": "window"
				},
				"umajin.path.osx.languageServer": {
					"type": "string",
					"default": "",
					"markdownDeprecationMessage": "Use `#umajin.path.mac.languageServer#` instead",
					"scope": "window"
				},
				"umajin.path.mac.languageServer": {
					"type": "string",
					"default": "",
					"markdownDescription": "The path to Umajin Language Server executable on Mac (relative to a workspace). Falls back to `#umajin.path.languageServer#`",
					"scope": "window"
				},
				"umajin.path.windows.languageServer": {
					"type": "string",
					"default": "",
					"markdownDescription": "The path to Umajin Language Server executable on Windows (relative to a workspace). Falls back to `#umajin.path.languageServer#`",
					"scope": "window"
				},
				"umajin.root": {
					"type": "string",
					"default": "start.u",
					"description": "The start file of the project",
					"scope": "window"
				},
				"umajin.simulate.compiler": {
					"type": "string",
					"default": "JIT",
					"enum": [
						"JIT",
						"AOT"
					],
					"description": "Compiler simulation",
					"enumDescriptions": [
						"Parse files as if in JIT",
						"Parse files as if in AOT"
					],
					"scope": "window"
				},
				"umajin.simulate.platform": {
					"type": "string",
					"default": "native",
					"enum": [
						"native",
						"windows",
						"mac-x86_64",
						"mac-arm64",
						"ios",
						"android",
						"linux-x86_64",
						"linux-aarch64"
					],
					"description": "Platform simulation",
					"enumDescriptions": [
						"Parse files as if on the native platform",
						"Parse files as if on Windows",
						"Parse files as if on Mac (Intel CPU)",
						"Parse files as if on Mac (Apple Silicon CPU)",
						"Parse files as if on iOS",
						"Parse files as if on Android",
						"Parse files as if on Linux x86_64",
						"Parse files as if on Linux AArch64"
					],
					"scope": "window"
				},
				"umajin.ui": {
					"type": "string",
					"default": "GUI",
					"enum": [
						"GUI",
						"CLI"
					],
					"description": "Interface",
					"enumDescriptions": [
						"Parse/launch with GUI",
						"Parse/launch with CLI"
					],
					"scope": "window"
				},
				"umajin.update.channels": {
					"type": "array",
					"items": {
						"type": "object",
						"title": "Engine update distribution channel",
						"properties": {
							"title": {
								"type": "string",
								"description": "Channel title"
							},
							"url": {
								"type": "string",
								"description": "Channel URL"
							}
						}
					},
					"default": [
						{
							"title": "Release",
							"url": "http://jenkins2.ur.local/view/Engine%20Release"
						},
						{
							"title": "Experimental",
							"url": "http://jenkins2.ur.local/view/Engine%20Labs"
						},
						{
							"title": "Nightly",
							"url": "http://jenkins2.ur.local/view/Engine%20Dev"
						}
					],
					"description": "The Jenkins view URLs for the engine updates",
					"scope": "window"
				}
			}
		},
		"configurationDefaults": {
			"[umajin]": {
				"editor.bracketPairColorization.enabled": false
			}
		},
		"debuggers": [
			{
				"type": "umajin",
				"label": "Umajin launch",
				"runtime": "node",
				"languages": [
					"umajin"
				],
				"configurationAttributes": {
					"launch": {
						"properties": {
							"arguments": {
								"type": "array",
								"description": "Extra arguments",
								"deprecationMessage": "This launch option is deprecated and will be removed in a future release. Use \"engineArguments\" and \"scriptArguments\" instead.",
								"default": [],
								"items": {
									"type": "string"
								}
							},
							"engineArguments": {
								"type": "array",
								"description": "Extra Umajin engine arguments",
								"default": [],
								"items": {
									"type": "string"
								}
							},
							"scriptArguments": {
								"type": "array",
								"description": "Script arguments",
								"default": [],
								"items": {
									"type": "string"
								}
							},
							"env": {
								"type": "object",
								"description": "Modifications & additions to the environment variables",
								"default": {},
								"items": {
									"type": "string"
								}
							},
							"envUnset": {
								"type": "array",
								"description": "Removals from the environment variables",
								"default": [],
								"items": {
									"type": "string"
								}
							},
							"logFormatEngineSourceInfo": {
								"type": "boolean",
								"default": false,
								"description": "Add engine source info to log messages",
								"scope": "window"
							},
							"logFormatThread": {
								"type": "boolean",
								"default": false,
								"description": "Add thread id to log messages",
								"scope": "window"
							},
							"logFormatTimestamp": {
								"type": "string",
								"enum": [
									"milli",
									"milli_float",
									"micro",
									"world_clock"
								],
								"default": "milli",
								"description": "Timestamp format in log",
								"enumDescriptions": [
									"Millisecond",
									"Millisecond floating point",
									"Microsecond",
									"World clock"
								]
							},
							"logLevel": {
								"type": "string",
								"enum": [
									"critical",
									"error",
									"warning",
									"info",
									"debug",
									"verbose"
								],
								"default": "debug",
								"description": "Log level",
								"enumDescriptions": [
									"Critical",
									"Error",
									"Warning",
									"Info",
									"Debug",
									"Verbose"
								]
							},
							"logToFile": {
								"type": "string",
								"default": "",
								"description": "Copy the log to the file",
								"scope": "window"
							},
							"overrideRootFile": {
								"type": "string",
								"default": "",
								"description": "The script file to launch",
								"scope": "window"
							},
							"overrideUI": {
								"type": "string",
								"default": "",
								"enum": [
									"GUI",
									"CLI"
								],
								"description": "Interface",
								"enumDescriptions": [
									"Launch with GUI",
									"Launch with CLI"
								],
								"scope": "window"
							}
						}
					},
					"attach": {
						"properties": {
							"logHost": {
								"type": "string",
								"default": "127.0.0.1",
								"description": "A host name for the log reader to connect to",
								"scope": "window"
							},
							"logPort": {
								"type": "number",
								"description": "A port number for the log reader to connect to",
								"scope": "window"
							},
							"logStream": {
								"type": "boolean",
								"description": "A flag describing whether the log output is streamed or packeted",
								"scope": "window"
							},
							"debugHost": {
								"type": "string",
								"default": "127.0.0.1",
								"description": "A host name for the log reader to connect to",
								"scope": "window"
							},
							"debugPort": {
								"type": "number",
								"description": "A port number for the debugger to connect to",
								"scope": "window"
							}
						}
					}
				},
				"initialConfigurations": [
					{
						"type": "umajin",
						"request": "launch",
						"name": "Umajin: Run"
					}
				],
				"configurationSnippets": [
					{
						"label": "Umajin: Run",
						"description": "A new configuration for launching Umajin.",
						"body": {
							"type": "umajin",
							"request": "launch",
							"name": "Umajin: Run"
						}
					},
					{
						"label": "Umajin: Attach",
						"description": "A new configuration for attaching to a running Umajin.",
						"body": {
							"type": "umajin",
							"request": "attach",
							"logPort": 47223,
							"debugPort": 21828,
							"name": "Umajin: Attach"
						}
					}
				]
			}
		],
		"grammars": [
			{
				"language": "umajin",
				"scopeName": "source.umajin",
				"path": "./syntaxes/umajin.tmLanguage.json"
			}
		],
		"languages": [
			{
				"id": "umajin",
				"aliases": [
					"Umajin",
					"umajin"
				],
				"extensions": [
					".u"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"semanticTokenModifiers": [
			{
