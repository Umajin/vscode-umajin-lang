	"scripts": {
		"vscode:prepublish": "npm run helper:bundle-extension-minified",
		"helper:prepare-debug": "npm run helper:bundle-extension -- --sourcemap",
		"helper:bundle-extension": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --external:@aws-sdk/client-s3 --format=cjs --platform=node",
		"helper:bundle-extension-minified": "npm run helper:bundle-extension -- --minify",

		"bump-major-version": "npm version --no-git-tag-version -- major",
		"bump-minor-version": "npm version --no-git-tag-version -- minor",
		"bump-patch-version": "npm version --no-git-tag-version -- patch",
		"after-manual-version-change": "npm install --package-lock-only --ignore-scripts",
		"update-dependencies": "sudo npm install -g @vscode/vsce && npm update --save && npm prune",

		"check": "eslint src && tsc --noEmit -p ./",

		"build-package": "vsce package --no-dependencies",
		"build-publish": "vsce publish --no-dependencies"
	},
